APP_NAME=Открой Хабаровский край
APP_ENV=development
APP_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@khabarovsk.example.com
ADMIN_PASSWORD=replace-before-use
CORS_ORIGINS=http://localhost:8082,http://localhost:8100,http://localhost:8601,http://localhost:19006
DATABASE_URL=sqlite:///runtime/users.db
CATALOG_PATH=catalog/objects.json
MANIFEST_PATH=dataset/manifest.csv
INDEX_PATH=artifacts/index.faiss
INDEX_METADATA_PATH=artifacts/index_metadata.json
MODEL_CACHE_DIR=artifacts/model_cache
MODEL_NAME=ViT-B-16
MODEL_PRETRAINED=openai
DEVICE=auto
MAX_UPLOAD_MB=10
CONTENT_DIR=content
KNOWLEDGE_DB_PATH=runtime/knowledge/knowledge.sqlite
API_PORT=8100
STREAMLIT_PORT=8601
EXPO_PORT=8082
ASSISTANT_ENABLED=true
ASSISTANT_RATE_LIMIT_PER_MINUTE=20
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct
OLLAMA_TIMEOUT_SECONDS=15
OLLAMA_TEMPERATURE=0.2
OLLAMA_MAX_TOKENS=350
